# Hoist Expo, React Native and Metro packages to root node_modules for CJS tool compatibility
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=@react-native*
public-hoist-pattern[]=@expo*

# Allow ALL packages to run build/postinstall scripts (pnpm v11+)
# Prevents ERR_PNPM_IGNORED_BUILDS on EAS Build
onlyBuiltDependencies[]=@sentry/cli
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=sharp
onlyBuiltDependencies[]=unrs-resolver
