NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Service Role key — Supabase Dashboard > Project Settings > API > Service Role (secret)
# REQUIRED: server-side reads use this to bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Root domain for subdomain routing
# Dev: localhost:3000  |  Prod: oni.vn
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AES-256-GCM key for encrypting connector tokens (generate with: openssl rand -hex 32)
CONNECTOR_ENCRYPTION_KEY=your-32-byte-hex-string

# ─── Google Sheets — Service Account ────────────────────────────────────────
# Lấy từ: Google Cloud Console > IAM & Admin > Service Accounts > JSON key
# Sau đó kích hoạt Google Sheets API tại: APIs & Services > Enable APIs
#
# GOOGLE_SERVICE_ACCOUNT_EMAIL: client_email trong file JSON
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY: private_key trong file JSON
#   (giữ nguyên các \n trong chuỗi key, đặt trong dấu nháy kép)
#
# NEXT_PUBLIC_GOOGLE_SERVICE_ACCOUNT_EMAIL: hiển thị cho user để share sheet
#   (dùng cùng giá trị với GOOGLE_SERVICE_ACCOUNT_EMAIL)
#
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
NEXT_PUBLIC_GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# ─── Google OAuth (deprecated — không dùng nữa) ──────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Zalo Login ──────────────────────────────────────────────────────────────
# Lấy từ Zalo Developers > Ứng dụng > Thông tin chung
# ZALO_APP_ID=
# ZALO_APP_SECRET=

# Local MySQL Connection
LOCAL_MYSQL_URI=mysql://root:admin@127.0.0.1:3306/oni_saas

# Local Postgres Connection (PostgreSQL 16)
LOCAL_PG_URI=postgresql://postgres:password@localhost:5432/oni_saas_local

# Telegram BOT token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Admin CHAT ID (send system report)
TELEGRAM_CHAT_ID=XXXX

# ─── Sentry Error Tracking ───────────────────────────────────────────────────
SENTRY_DSN="https://your-sentry-dsn@o0.ingest.sentry.io/0"
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@o0.ingest.sentry.io/0"
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="your-sentry-project"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# ─── Cloudflare R2 (S3 Compatible Storage) ──────────────────────────────────
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="oni-saas-bucket"
R2_PUBLIC_URL="https://pub-xxxxxx.r2.dev"
R2_REGION="auto"

# ─── Cloudflare Turnstile (Anti-Spam / Anti-Bot) ─────────────────────────────
# Đăng ký tại: Cloudflare Dashboard > Turnstile
# Nếu bỏ trống hoặc không cấu hình, hệ thống sẽ tự động BỎ QUA (skip) xác thực captcha.
# Ở môi trường Local / Development, bạn có thể sử dụng các key thử nghiệm (sandbox keys) sau:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA (always pass widget)
#   TURNSTILE_SECRET_KEY=1x00000000000000000000000000000000 (always pass secret)
#
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Caching Configuration (Hybrid Plug-n-Play) ──────────────────────────────
ENABLE_CACHE=false
CACHE_PROVIDER=memory # 'memory' or 'redis'
REDIS_URL=redis://localhost:6379

# ─── Realtime Notification Provider (Hybrid Plug-n-Play) ─────────────────────
# Lựa chọn kênh truyền thông báo: 'supabase' (mặc định đám mây) hoặc 'socketio' (WebSocket local)
REALTIME_PROVIDER=supabase
NEXT_PUBLIC_REALTIME_PROVIDER=supabase

# BACKUP CONFIG (for scripts/backup.sh)
RCLONE_R2_REMOTE=r2
RCLONE_R2_PATH=backup-oni

# Cài đặt Secret để hỗ trợ Cron qua /api/cron/daily-scan
# openssl rand -hex 32
CRON_SECRET=your-secret-key