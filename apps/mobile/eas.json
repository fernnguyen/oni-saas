{
  "cli": {
    "version": ">= 20.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.15.0",
      "env": {
        "CI": "0"
      },
      "android": {
        "buildType": "apk"
      },
      "postInstall": "bash scripts/setup-google-services.sh"
    },
    "preview": {
      "distribution": "internal",
      "node": "22.15.0",
      "env": {
        "CI": "0"
      },
      "postInstall": "bash scripts/setup-google-services.sh"
    },
    "production": {
      "autoIncrement": true,
      "node": "22.15.0",
      "postInstall": "bash scripts/setup-google-services.sh"
    }
  },
  "submit": {
    "production": {}
  }
}

