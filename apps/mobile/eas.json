  },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "node": "22.15.0",
      "env": {
        "CI": "0"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "node": "22.15.0",
