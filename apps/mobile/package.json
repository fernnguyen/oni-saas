{
  "name": "@oni/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_NO_METRO_LAZY=1 expo start",
    "android": "EXPO_NO_METRO_LAZY=1 expo start --android",
    "ios": "EXPO_NO_METRO_LAZY=1 expo start --ios",
    "web": "EXPO_NO_METRO_LAZY=1 expo start --web",
    "ts:check": "tsc",
    "eas-build-pre-install": "bash scripts/setup-google-services.sh",
    "eas:helper": "node scripts/eas-helper.js",
    "release": "node scripts/release.js",
    "build:ios:local": "eas build --platform ios --profile production --local",
    "submit:ios:local": "eas submit --platform ios",
    "build:android:local": "eas build --platform android --profile production --local",
    "submit:android:local": "eas submit --platform android"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@oni/adapters": "workspace:*",
    "@oni/core": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.105.3",
    "drizzle-orm": "^0.45.2",
    "expo": "~54.0.0",
    "expo-av": "~16.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "^8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "^14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "^17.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "^15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^4.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "^0.2.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-transform-react-jsx": "^7.20.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.11",
    "typescript": "~5.9.2"
  }
}
