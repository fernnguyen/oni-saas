{
  "name": "oni-saas-starter",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev apps/web",
    "build": "next build apps/web",
    "start": "next start apps/web",
    "lint": "eslint apps/web --ext .ts,.tsx",
    "db:push": "pnpm -C packages/adapters run db:push",
    "db:push:pg": "pnpm -C packages/adapters run db:push:pg",
    "db:generate": "pnpm -C packages/adapters run db:generate",
    "mobile:start": "pnpm --filter @oni/mobile start",
    "mobile:ios": "pnpm --filter @oni/mobile ios",
    "mobile:android": "pnpm --filter @oni/mobile android",
    "mobile:eas": "pnpm --filter @oni/mobile eas:helper",
    "mobile:eas:local": "pnpm --filter @oni/mobile eas:helper local",
    "mobile:ios:build": "pnpm --filter @oni/mobile build:ios:local",
    "mobile:ios:submit": "pnpm --filter @oni/mobile submit:ios:local",
    "mobile:android:build": "pnpm --filter @oni/mobile build:android:local",
    "mobile:android:submit": "pnpm --filter @oni/mobile submit:android:local"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-transform-react-jsx": "^7.20.0",
    "babel-preset-expo": "~54.0.11",
    "@types/node": "^25.6.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.6",
    "metro": "^0.80.12",
    "metro-config": "^0.80.12",
    "metro-runtime": "^0.84.4",
    "tsx": "^4.22.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@oni/adapters": "workspace:*",
    "@oni/core": "workspace:*",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.49.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@tanstack/react-query": "^5.100.9",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.2",
    "html5-qrcode": "^2.3.8",
    "konva": "^10.3.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "postcss": "^8.5.14",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-konva": "^19.2.4",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.4",
    "use-debounce": "^10.1.1",
    "zod": "^3.23.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "@types/react": "19.1.10",
      "@types/react-dom": "19.1.10",
      "@expo/metro-runtime": "6.1.2"
    }
  }
}
