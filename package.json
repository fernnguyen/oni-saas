{
  "name": "oni-saas-starter",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev apps/web",
    "build": "next build apps/web",
    "start": "next start apps/web",
    "lint": "eslint apps/web --ext .ts,.tsx",
    "db:push": "pnpm -C packages/adapters run db:push",
    "db:generate": "pnpm -C packages/adapters run db:generate"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.6",
    "tsx": "^4.22.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@oni/adapters": "workspace:*",
    "@oni/core": "workspace:*",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.49.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@tanstack/react-query": "^5.100.9",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.2",
    "next": "16.2.6",
    "postcss": "^8.5.14",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.4",
    "use-debounce": "^10.1.1",
    "zod": "^3.23.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  }
}
